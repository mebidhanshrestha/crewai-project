# OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-key-here

# Swap the model with one line (any CrewAI-supported provider works)
LLM_MODEL=openai/gpt-5-mini
# LLM_MODEL=openai/gpt-5                     # stronger, pricier
# LLM_MODEL=anthropic/claude-sonnet-5-5      # needs ANTHROPIC_API_KEY
# LLM_MODEL=gemini/gemini-3.8-flash          # needs GEMINI_API_KEY (free tier: 5/min, 20/day)

# Requests per minute cap. Use 4 on the Gemini free tier.
MAX_RPM=30
